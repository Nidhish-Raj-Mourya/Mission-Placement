 #include<iostream>
using namespace std;
int array1(int size){
    int arr[size];
    int count=0;
    for(int i=0;i<size;i++){
        cin>>arr[i];
    }
    for(int i =0;i<size-1;i++){
        if(arr[i]<arr[i+1]){
          count++;
          break;
        }
    }
    if(count==0){
        cout<<"Yes";
    }
    else{
        cout<<"No";
    }

return 0;
}
int main(){
    int size;

    cout<<"Enter the size ";
    cin>>size;

    array1(size);

    return 0;

}